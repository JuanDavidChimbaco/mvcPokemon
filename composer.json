{
    "name": "mvcpokemon/mvcpokemon",
    "description": "Pokémon MVC Shop - Modern PHP MVC Architecture",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "app/Core/",
            "Modules\\": "app/Modules/",
            "Shared\\": "app/Shared/"
        },
        "classmap": [
            "database/migrations/",
            "database/seeders/"
        ],
        "files": [
            "app/bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}