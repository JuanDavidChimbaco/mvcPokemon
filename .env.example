# Aplicación
APP_NAME="PokéTienda"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/mvcPokemon/
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es

# Base de datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pokemon33
DB_USER=root
DB_PASS=

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=pokemon_session
SESSION_DOMAIN=
SESSION_SECURE=false

# Cache
CACHE_DRIVER=file

# Logging
LOG_CHANNEL=single
LOG_LEVEL=debug

# Paginación
PAGINATION_PER_PAGE=12